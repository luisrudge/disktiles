root = true

[*]
end_of_line = lf

# Analyzer exceptions, one per line, each with its reason. Warnings fail the build (Omasharp.targets);
# turn a rule off here only when it's wrong for this app, never to make a build pass.
[*.cs]
# Declare types in namespaces: an app is one executable, and the backend lives in the global
# namespace (BackendType defaults to Backend).
dotnet_diagnostic.CA1050.severity = none
# Visible fields: the core's arena structs (Tree.cs, Listing.cs, Filter.cs) are plain data on
# purpose, as in the GTK original.
dotnet_diagnostic.CA1051.severity = none
# Names that are VB keywords (Next, Error): this app is C# only.
dotnet_diagnostic.CA1716.severity = none

[tests/**.cs]
# Test data arrays, each used once.
dotnet_diagnostic.CA1861.severity = none
